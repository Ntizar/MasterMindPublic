# Copia a ~/.hermes/.env — NUNCA al repositorio.
# Añade .env a tu .gitignore ANTES de rellenarlo.

# --- Proveedor de modelos (cualquiera compatible con OpenAI) ---
OPENAI_BASE_URL=https://tu-proveedor.example/v1
OPENAI_API_KEY=pon-tu-clave-aqui
EMBED_MODEL=tu-modelo-de-embeddings

# --- Rutas (opcionales) ---
CHROMA_PATH=~/.mastermind/chromadb

# --- GitHub (solo para el explorador de fuentes) ---
GITHUB_TOKEN=

# --- Avisos por Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
